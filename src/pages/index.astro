---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButtons from '../components/CTAButtons.astro';
import heroVideo from '../assets/media/RealEyes-Website-HERO-Video-2025-720P.mp4?url';
import banner from '../assets/media/banner1.jpg';
import rootsBackground from '../assets/media/root-bg.jpg';
import software from '../assets/media/software.png';
import design from '../assets/media/wdesign.png';
import device from '../assets/media/wdevice1.png';
import support from '../assets/media/support.png';
import interactiveDisplay from '../assets/media/interactivedisplat2.png';
import passiveDisplay from '../assets/media/Untitled-2.png';
import clientLogos from '../assets/media/logos.png';
import quote from '../assets/media/quote1.png';
import showcase from '../assets/media/section-image.jpg';
import kioskIcon from '../assets/media/Kiosk-Icon-Color.png';
import gallery from '../assets/media/group2.jpg';

const strengths = [
  [software, 'Enterprise Software'],
  [design, 'Expert Design'],
  [device, 'Device Support'],
  [support, 'People Support'],
] as const;
---

<BaseLayout
  title="Interactive Digital Signage | RealEyes Displays"
  description="RealEyes Displays creates and supports passive and interactive digital signage systems, backed by more than 20 years of experience."
  image={banner.src}
>
  <section class="home-hero site-shell">
    <video autoplay muted loop playsinline preload="metadata" poster={banner.src} aria-hidden="true">
      <source src={heroVideo} type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
    <h1 data-reveal="left">
      <span>20+ Years of</span>
      <span>Digital Signage</span>
      <span>&amp; Caring for People.</span>
    </h1>
    <div class="hero-actions"><CTAButtons /></div>
  </section>

  <section class="roots-preview site-shell" style={`--roots-bg: url(${rootsBackground.src})`}>
    <div class="roots-heading" data-reveal="left">
      <h2>Our Roots</h2>
      <p>Experience Our Strength</p>
    </div>
    <div class="roots-copy" data-reveal="right">
      <h3>We delight Marketing Managers.<br />We give IT Managers some of their life back.</h3>
      <p>Care for the system. Care for the people. It’s in our roots.</p>
      <div class="strengths">
        {strengths.map(([icon, label], index) => (
          <div class="strength">
            <Image src={icon} alt="" loading="lazy" />
            <span>{label}</span>
            {index < strengths.length - 1 && <b aria-hidden="true">+</b>}
          </div>
        ))}
      </div>
    </div>
    <a class="roots-link" href="/our-roots/">Learn More</a>
  </section>

  <section class="solution-grid site-shell page-pad section-space" aria-label="Display solutions">
    <a class="solution-card" href="/interactive/" data-reveal="left">
      <div class="solution-image"><Image src={interactiveDisplay} alt="Interactive display and kiosk examples" loading="lazy" /></div>
      <div class="solution-body">
        <p>Touch screens and interactive designs<br />Suitable for schools, office buildings, events &amp; more.</p>
        <h2>Interactive Displays <span aria-hidden="true">›</span></h2>
      </div>
    </a>
    <a class="solution-card" href="/passive-displays/" data-reveal="right">
      <div class="solution-image"><Image src={passiveDisplay} alt="Passive digital signage examples" loading="lazy" /></div>
      <div class="solution-body">
        <p>Non-touch digital signage<br />Easy to set up, intuitive to maintain, and scalable for many industries.</p>
        <h2>Passive Displays <span aria-hidden="true">›</span></h2>
      </div>
    </a>
  </section>

  <section class="testimonial site-shell section-space">
    <div class="client-logos"><Image src={clientLogos} alt="Association of Graduates and Air Force Academy Foundation" loading="lazy" /></div>
    <blockquote data-reveal="up">“Coming into interactive/digital projects like this can be very overwhelming. This was not the case with Alex and RealEyes Displays. Alex is extremely friendly, professional, and project oriented. He will be there every step of the way to make sure you get exactly what you are looking for.”</blockquote>
    <Image class="quote-mark" src={quote} alt="" loading="lazy" />
  </section>

  <section class="showcase site-shell">
    <Image src={showcase} alt="Interactive distinguished graduate recognition display" loading="lazy" quality={86} />
  </section>

  <section class="contact-panel site-shell" data-reveal="up">
    <div class="contact-copy">
      <Image src={kioskIcon} alt="" loading="lazy" />
      <h2>Got A Display Idea? Want To Talk To An Expert?</h2>
      <a class="button" href="/contact-us/">Contact Us</a>
    </div>
    <Image class="contact-photo" src={gallery} alt="A room of installed interactive kiosks" loading="lazy" />
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    width: 100%;
    height: 765px;
    overflow: hidden;
    background: #1c1c1c;
  }

  .home-hero video,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero video {
    object-fit: cover;
  }

  .hero-shade {
    background: linear-gradient(90deg, rgb(0 0 0 / 28%), transparent 70%);
  }

  .home-hero h1 {
    position: absolute;
    top: 220px;
    left: 20px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
    color: #fff;
    font-size: clamp(2.7rem, 5vw, 4.1rem);
    font-weight: 650;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-shadow: 0 3px 8px rgb(0 0 0 / 38%);
  }

  .hero-actions {
    position: absolute;
    right: 0;
    bottom: 80px;
    left: 0;
  }

  .roots-preview {
    position: relative;
    display: grid;
    grid-template-columns: 40% 60%;
    min-height: 595px;
    margin-top: 10px;
    width: min(calc(100% - 20px), calc(var(--content) - 20px));
    overflow: hidden;
    border-radius: 12px;
    color: #fff;
    background: var(--ink) var(--roots-bg) center / cover no-repeat;
  }

  .roots-heading {
    align-self: center;
    padding: 20px;
  }

  .roots-heading h2 {
    margin: 0;
    font-size: clamp(3.5rem, 6vw, 5rem);
  }

  .roots-heading p {
    font-size: 25px;
    text-transform: uppercase;
  }

  .roots-copy {
    align-self: center;
    padding: 40px 38px;
  }

  .roots-copy h3 {
    font-size: clamp(1.7rem, 3vw, 2.25rem);
    font-weight: 450;
  }

  .roots-copy > p {
    font-size: 20px;
    font-weight: 700;
  }

  .strengths {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px;
    margin-top: 55px;
  }

  .strength {
    position: relative;
    min-height: 105px;
    padding: 43px 10px 12px;
    background: var(--red);
    text-align: center;
    text-transform: uppercase;
  }

  .strength :global(img) {
    position: absolute;
    top: -42px;
    left: 50%;
    width: 76px;
    height: 76px;
    object-fit: contain;
    transform: translateX(-50%);
  }

  .strength b {
    position: absolute;
    top: 45%;
    right: -27px;
    color: #aaa;
  }

  .roots-link {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 17px;
    color: #fff;
    background: var(--red);
    font-size: 23px;
    font-weight: 650;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .solution-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding-top: 20px;
  }

  .solution-card {
    overflow: hidden;
    border-radius: 12px;
    background: var(--gray);
    text-decoration: none;
  }

  .solution-image {
    height: 300px;
    padding: 10px 16px 0;
    border-bottom: 60px solid var(--red);
    background: #fff;
  }

  .solution-image :global(img) {
    display: block;
    margin-inline: auto;
    height: auto;
  }

  .solution-card:first-child .solution-image :global(img) {
    width: auto;
    height: 309px;
  }

  .solution-card:last-child .solution-image :global(img) {
    width: calc(100% + 32px);
    max-width: none;
    margin-inline: -16px;
  }

  .solution-body {
    min-height: 205px;
    padding: 35px 20px 20px;
    color: #ddd;
  }

  .solution-body h2 {
    margin: 26px 0 0;
    color: #fff;
  }

  .solution-body span {
    display: inline-grid;
    width: 40px;
    height: 40px;
    margin-left: 10px;
    border: 4px solid var(--red);
    border-radius: 10px;
    color: var(--red);
    place-items: center;
  }

  .testimonial {
    position: relative;
    padding: 100px 8% 85px;
    color: #fff;
    background: #464646;
  }

  .client-logos {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(790px, 70%);
    padding: 15px 45px;
    border-radius: 0 0 80px 80px;
    background: #fff;
    transform: translateX(-50%);
  }

  .testimonial blockquote {
    margin: 35px auto 0;
    font-size: clamp(1.7rem, 3vw, 2.8rem);
    font-style: italic;
    line-height: 1.65;
    text-align: center;
  }

  .quote-mark {
    position: absolute;
    right: 10px;
    bottom: 20px;
    width: 100px;
  }

  .showcase :global(img) {
    width: 100%;
    height: auto;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: 46% 54%;
    gap: 20px;
    width: min(calc(100% - 20px), calc(var(--content) - 20px));
    margin-top: 30px;
    border-radius: 20px;
    padding: 30px;
    background: #eee;
  }

  .contact-copy {
    align-self: center;
  }

  .contact-copy :global(img) {
    width: 120px;
    margin: 0 auto 25px;
  }

  .contact-copy h2 {
    font-size: clamp(2rem, 3vw, 2.6rem);
  }

  .contact-copy .button {
    width: 100%;
    text-transform: uppercase;
  }

  .contact-photo :global(img),
  :global(.contact-photo) {
    width: 100%;
    height: 470px;
    border-radius: 20px;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .home-hero {
      height: 744px;
    }

    .home-hero video {
      object-position: 60% center;
    }

    .home-hero h1 {
      top: 220px;
      left: 20px;
      max-width: 340px;
      font-size: 1.8rem;
      line-height: 1.24;
    }

    .hero-actions {
      bottom: 70px;
    }

    .roots-preview {
      grid-template-columns: 1fr;
      min-height: 980px;
      margin-inline: 10px;
      background-position: 38% center;
    }

    .roots-heading {
      align-self: end;
      padding: 70px 24px 10px;
    }

    .roots-heading h2 {
      font-size: 3.3rem;
    }

    .roots-copy {
      align-self: start;
      padding: 10px 24px 100px;
    }

    .roots-copy h3 {
      font-size: 1.55rem;
    }

    .strengths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 64px 24px;
    }

    .strength b {
      display: none;
    }

    .solution-grid {
      grid-template-columns: 1fr;
      gap: 95px;
      padding-top: 95px;
    }

    .solution-image {
      height: 260px;
    }

    .solution-image :global(img) {
      max-width: 100%;
    }

    .solution-card:first-child .solution-image :global(img) { height: 278px; }
    .solution-card:last-child .solution-image :global(img) { width: calc(100% + 32px); }

    .testimonial {
      padding: 55px 28px;
    }

    .client-logos,
    .quote-mark,
    .showcase {
      display: none;
    }

    .testimonial blockquote {
      margin: 0;
      font-size: 1.12rem;
      line-height: 1.7;
    }

    .contact-panel {
      grid-template-columns: 1fr;
      margin: 90px 10px 0;
      padding: 24px;
    }

    .contact-photo :global(img),
    :global(.contact-photo) {
      height: 330px;
    }
  }
</style>
