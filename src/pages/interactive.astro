---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import IndustryHero from '../components/IndustryHero.astro';
import IndustryTabs from '../components/IndustryTabs.astro';
import ProcessTabs from '../components/ProcessTabs.astro';
import GalleryCarousel from '../components/GalleryCarousel.astro';
import CTAButtons from '../components/CTAButtons.astro';
import VideoCard from '../components/VideoCard.astro';

import hero from '../assets/media/interactive-display.jpg';
import chamber from '../assets/media/chamerb1.png';
import events from '../assets/media/eventshow1.png';
import office from '../assets/media/office-highrise.png';
import corporate from '../assets/media/office-hq.png';
import university from '../assets/media/universitycamp.png';
import church from '../assets/media/Church-1-1.png';
import museum from '../assets/media/musem.png';
import poster1 from '../assets/media/youtube-mErXlGSCNLw.jpg';
import poster2 from '../assets/media/youtube-NgnXAGa7Qbs.jpg';
import poster3 from '../assets/media/youtube-uzwWirFZ5Oo.jpg';
import consultation from '../assets/media/Consultation.png';
import contentGuideline from '../assets/media/Content-Guideline-pic-1.png';
import designScope from '../assets/media/Design-Scope-1.png';
import estimate from '../assets/media/Estimate-Order.png';
import shipping from '../assets/media/Shipping.png';
import installation from '../assets/media/Installation.png';
import training from '../assets/media/Training.png';
import intuifaceBg from '../assets/media/intuiface-bg.jpg';
import intuifaceWhite from '../assets/media/intu-white.png';
import intuifaceLogo from '../assets/media/intuiface-logo.png';
import expert from '../assets/media/image2.png';
import gallery1 from '../assets/media/266354878_1871287613042626_8673524322770208186_n.jpg';
import gallery2 from '../assets/media/UWSP-Welcome-Center-scaled.jpg';
import gallery3 from '../assets/media/StBarnabas-ScheduleBoard-scaled.jpg';
import gallery4 from '../assets/media/RealEyesRosalindInstall-scaled.jpg';
import gallery5 from '../assets/media/PXL_20210302_204112585-scaled.jpg';
import gallery6 from '../assets/media/PXL_20210302_194125616-scaled.jpg';
import gallery7 from '../assets/media/Matc-Gallery-2-scaled.jpg';
import gallery8 from '../assets/media/Matc-Gallery-1-scaled.jpg';
import gallery9 from '../assets/media/IMG_20241209_134718-4-scaled.jpg';
import iconLocal from '../assets/media/INicos_0006_4ID_0038_icuun-copy-4-1.png';
import iconSponsor from '../assets/media/INicos_0005_4ID_0039_icuun-copy-3-1.png';
import iconCoupon from '../assets/media/INicos_0004_4ID_0040_icuun-copy-2-1.png';
import iconHistory from '../assets/media/INicos_0003_4ID_0041_icuun-copy.png';
import iconStory from '../assets/media/INicos_0002_4ID_0042_icuun-copy-5.png';
import iconWayfinding from '../assets/media/INicos_0001_4ID_0043_icuun-copy-6.png';
import iconSchedule from '../assets/media/INicos_0000_4ID_0044_icuun-copy-7.png';

const commonIcons = [iconLocal, iconSponsor, iconCoupon, iconHistory, iconStory, iconWayfinding, iconSchedule];

const industries = [
  { label: 'Chamber of Commerce / Tourism', title: 'Chamber of Commerce / Tourism', description: 'An interactive display works like a 24/7 interactive tour guide for your visitors. Educate about local points of interest, promote businesses, share history with parallax timelines and digital storytelling.', image: chamber, imageAlt: 'Tourism interactive kiosk', icons: commonIcons },
  { label: 'Events & Tradeshows', title: 'Events & Tradeshows', description: 'An interactive display can function in many ways for your event. Collect visitor information through quizzes and interactive games, prize giveaways, and educate about products or events related to your organization. Create meaningful interactions when the hype is high!', image: events, imageAlt: 'Interactive event display', icons: commonIcons },
  { label: 'Office Buildings / High Rise', title: 'Office Buildings / High Rise', description: 'For many high-rise buildings, there’s more than meets the eye. Use 3D wayfinding to direct visitors quickly and efficiently, educate them about all your building has to offer, capture leads, and share agent contact information.', image: office, imageAlt: 'Office interactive display', icons: commonIcons.slice(2) },
  { label: 'Corporate Headquarters', title: 'Corporate Headquarters', description: 'Interactive displays pair well with a full digital signage system in your corporate headquarters. Welcome important visitors, communicate company values and history, and connect 3D wayfinding, directories, and room reservations.', image: corporate, imageAlt: 'Corporate headquarters interactive display', icons: commonIcons },
  { label: 'University / Campus', title: 'University / Campus', description: 'Create an end-to-end experience for current students, prospective students, visitors, alumni, and donors. Welcome centers engage newcomers, kiosks direct traffic, donor displays inspire giving, and internal displays keep staff informed.', image: university, imageAlt: 'University interactive display', icons: commonIcons },
  { label: 'Church / House of Worship', title: 'Church / House of Worship', description: 'Interactive displays make newcomers feel welcome, donors appreciated, and existing members more engaged. Visitors can learn about programs and history, view photo galleries, sign up for events, and stay connected.', image: church, imageAlt: 'Church interactive display', icons: commonIcons.slice(1, 6) },
  { label: 'Exhibit / Museum', title: 'Exhibit / Museum', description: 'Extend the exhibit experience with sensors, lights, buttons and more. Help visitors make the most of their visit with 3D wayfinding, historical and themed storytelling, AI connections, and memorable hands-on interactions.', image: museum, imageAlt: 'Museum interactive display', icons: commonIcons },
];

const process = [
  { label: 'Free Consultation', image: consultation, text: 'We’ll ask questions, listen, and present lots of options to design your display.' },
  { label: 'Content Guideline', image: contentGuideline, text: 'A rough draft of what content you have and how much. We’ll provide a blank template, essentially a bullet-point document, to easily organize everything.' },
  { label: 'Design Scope', image: designScope, text: 'We’ll review, annotate, and update your content guideline, which becomes the initial design scope. We’ll assign a number of hours to build it and discuss any changes needed.' },
  { label: 'Estimate & Order', image: estimate, text: 'We’ll create a formal estimate of costs for all hardware and services we’re providing, along with approximate delivery times. Order with confidence, and we’ll get to work.' },
  { label: 'Design, Hardware Setup, Shipping', image: shipping, text: 'Your RealEyes TV Players will be registered, updated, configured for plug-and-play, and tested for 24 hours before shipping.' },
  { label: 'Connect & Install', image: installation, text: 'Displays and hardware are installed, then HDMI, power, and internet bring your RealEyes Display to life.' },
  { label: 'Training & Support', image: training, text: 'We monitor and support your players and hardware, solve most issues remotely, and train registered users as part of your subscription.' },
];
---

<BaseLayout
  title="Interactive Digital Signage | RealEyes Displays"
  description="Custom interactive digital signage, kiosks, wayfinding, storytelling, directories, and touchscreen experiences for almost any industry."
  image={hero.src}
>
  <IndustryHero image={hero} alt="Interactive digital signage installed in a lobby" />
  <div class="red-band hero-band" data-reveal="up"><h1>Custom Interactive Experiences For Almost Any Industry</h1></div>
  <div class="site-shell"><IndustryTabs id="interactive-industries" tabs={industries} /></div>

  <div class="red-band section-space" data-reveal="down"><h2>Elegant Design with Your Audience in Mind</h2></div>
  <section class="experience site-shell page-pad">
    <div class="video-feature"><VideoCard title="Directory & Room Status Tablets" poster={poster1} youtubeId="mErXlGSCNLw" /></div>
    <div class="experience-copy">
      <p><strong>Engaging</strong> – Eye-catching, animated content your audience can see, hear, and touch.</p>
      <p><strong>Opt-in Content</strong> – Visitors choose what to explore, making your message more effective.</p>
      <p><strong>Tracking</strong> – Know what content works best with built-in touch analytics.</p>
      <p><strong>Intuitive</strong> – Easy for all ages to use, from kids to seniors.</p>
      <p><strong>Web-Connected &amp; Scalable</strong> – Update anytime, manage multiple screens, and add users with ease.</p>
      <p><strong>System Integration</strong> – Seamlessly connect to your existing data and keep content updated automatically.</p>
    </div>
    <VideoCard title="Interactive digital signage turns passive viewers into active participants." poster={poster2} youtubeId="NgnXAGa7Qbs" />
    <VideoCard title="It delivers personalized, on-demand information in real time." poster={poster3} youtubeId="uzwWirFZ5Oo" />
  </section>

  <div class="gallery-band section-space">
    <div class="site-shell"><GalleryCarousel dark coverflow images={[gallery1, gallery2, gallery3, gallery4, gallery5, gallery6, gallery7, gallery8, gallery9]} label="Interactive display installations" /></div>
  </div>

  <div class="site-shell section-space">
    <ProcessTabs items={process} intro="We’ve refined our process over the years for maximum efficiency, accurate setup, and beautiful displays. Interactive displays have a few extra steps to define the interactive scope, and we’re with you every step of the way." />
  </div>

  <div class="red-band section-space" data-reveal="up"><h2>Scaling for large deployments?</h2></div>
  <h2 class="scale-copy">No Problem! We provide a scope of manageable milestones,<br />executing from start to finish</h2>

  <section class="intuiface site-shell" style={`--intuiface-bg: url(${intuifaceBg.src})`}>
    <div class="intuiface-top">
      <div class="intuiface-partner" data-reveal="left">
        <Image src={intuifaceWhite} alt="Intuiface" loading="lazy" />
        <h2>Platinum Partner</h2>
        <p>Alex, owner of RealEyes Displays, is one of the earliest designer-developers with the Intuiface Platform.</p>
      </div>
      <Image class="intuiface-expert" src={expert} alt="Alex, RealEyes Displays’ Intuiface expert" loading="lazy" />
      <blockquote class="intuiface-quote">
        <p>“RealEyes Displays is one of our earliest creative experts, with over 13 years of experience. Alex and his team find elegant ways to solve technical challenges, and their output always has a signature polish.”</p>
        <cite>Seb M., Intuiface Customer Success Manager</cite>
      </blockquote>
    </div>
    <h2>What is Intuiface? We’re glad you asked.</h2>
    <div class="intuiface-copy">
      <p>Intuiface is an interactive software platform. It’s primarily used for interactive digital signage, but it has a suite of triggers and actions that lend amazing creative freedom to the designer. Build video-wall control panels, corporate presentations, directories, product showcases, itinerary builders, halls of fame, and data-driven experiences—all triggered instantaneously from a tablet 1,000 miles away.</p>
      <p>We’ve spent over a decade with Intuiface as our platform of choice for its creative and integration freedom, ease of deployment, company support, and culture of giving in its design community. Leverage our experience and success for your next project.</p>
    </div>
  </section>

  <section class="intuiface-help site-shell page-pad">
    <Image src={intuifaceLogo} alt="Intuiface" loading="lazy" />
    <div>
      <h2>Already an Intuiface user? Need help?</h2>
      <p>You can book Alex for advanced training sessions, consultations, or to build your project from start to finish. If you’re new and learning, we highly suggest taking the free Intuiface Academy courses first.</p>
    </div>
  </section>

  <section class="soft-panel site-shell more-help" data-reveal="up">
    <h2>Don’t see your organization or the display type you need?</h2>
    <p>Don’t worry! We support almost all industries and all signage displays that we deploy.</p>
    <p>Consultations are free, easy and educational. <strong>We promise.</strong></p>
    <div>Use the buttons below to schedule a call:</div>
  </section>
  <div class="site-shell cta-section"><CTAButtons lightBackground /></div>
</BaseLayout>

<style>
  .hero-band { margin-top: -35px; }

  .experience {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 38px;
    padding-top: 35px;
  }

  .experience-copy {
    align-self: start;
    border: 1px solid #aaa;
    border-radius: 16px;
    padding: 28px;
    background: #eee;
    font-size: 18px;
  }

  .experience-copy p:first-child { margin-top: 0; }
  .experience-copy p:last-child { margin-bottom: 0; }

  .experience-copy strong {
    transition: color 220ms ease;
  }

  .experience-copy strong:hover {
    color: var(--red);
  }

  .video-feature { min-height: 0; }

  .gallery-band {
    width: 100%;
    background: #494949;
  }

  .gallery-band :global(.carousel.dark) {
    background: transparent;
  }

  .scale-copy {
    margin: 45px 20px;
    color: var(--red);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    text-align: center;
  }

  .intuiface {
    padding: 40px;
    border-radius: 18px;
    overflow: hidden;
    color: #fff;
    background: #132a35 var(--intuiface-bg) center / cover no-repeat;
  }

  .intuiface-top {
    display: grid;
    grid-template-columns: minmax(220px, .9fr) minmax(220px, .75fr) minmax(280px, 1.2fr);
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
  }

  .intuiface-partner { text-align: right; }
  .intuiface-partner > :global(img) { width: min(100%, 220px); }
  .intuiface-partner h2 { margin: 8px 0; }
  .intuiface-partner p { margin: 0; }
  .intuiface-expert { width: 100%; max-height: 330px; object-fit: contain; }
  .intuiface-quote {
    margin: 0;
    border-radius: 12px;
    padding: 24px;
    color: #def6ff;
    background: rgb(255 255 255 / 25%);
  }
  .intuiface-quote p { margin-top: 0; font-size: 16px; }
  .intuiface-quote cite { color: #85ddf0; font-style: normal; font-weight: 700; }
  .intuiface > h2 { margin: 16px 0; font-size: clamp(2rem, 4vw, 3rem); text-align: center; }
  .intuiface p { font-size: 18px; }
  .intuiface-copy { padding-inline: 34px; text-align: center; }

  .intuiface-help {
    display: grid;
    grid-template-columns: 32% 1fr;
    align-items: center;
    gap: 40px;
    padding-top: 50px;
    padding-bottom: 50px;
  }

  .intuiface-help > :global(img) { width: 100%; max-height: 170px; object-fit: contain; }
  .intuiface-help h2 { color: var(--red); }

  .more-help { margin-top: 35px; }
  .more-help h2 { color: var(--red); font-size: clamp(2rem, 4vw, 2.8rem); }
  .more-help p { margin-bottom: 8px; font-size: 22px; }
  .more-help > div { margin-top: 30px; border-radius: 12px; padding: 18px; color: #fff; background: var(--ink); text-align: center; }
  .cta-section { padding: 45px 0 5px; }

  @media (max-width: 767px) {
    .hero-band { margin-top: -18px; }
    .experience { grid-template-columns: 1fr; }
    .video-feature { min-height: 0; }
    .intuiface { width: calc(100% - 20px); margin-inline: auto; padding: 30px 20px; }
    .intuiface-top, .intuiface-help { grid-template-columns: 1fr; }
    .intuiface-partner { text-align: center; }
    .intuiface-copy { padding-inline: 0; }
    .more-help { width: calc(100% - 20px); margin-inline: auto; }
    .more-help p { font-size: 18px; }
  }
</style>
