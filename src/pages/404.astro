---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | RealEyes Displays" description="The requested page could not be found.">
  <main class="not-found page-pad site-shell">
    <p class="eyebrow">404</p>
    <h1>We couldn’t find that display.</h1>
    <p>The page may have moved during our website update.</p>
    <a class="button" href="/">Return Home</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    padding-top: 220px;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    color: var(--red);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: .2em;
  }

  h1 {
    margin: 12px 0;
    font-size: clamp(2.4rem, 6vw, 5rem);
  }

  .button {
    margin-top: 24px;
  }
</style>
