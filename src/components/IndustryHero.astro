---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<section class="industry-hero site-shell">
  <Image src={image} alt={alt} loading="eager" quality={88} />
  <div class="industry-copy" aria-label="One vendor. All of your signage displays. All of your users. Everywhere.">
    <p class="dark">One vendor.</p>
    <p>All of your<br />signage displays.</p>
    <p class="dark">All of your<br />users.</p>
    <p>Everywhere.</p>
  </div>
</section>

<style>
  .industry-hero {
    position: relative;
    height: 770px;
    overflow: hidden;
    background: #ddd;
  }

  .industry-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .industry-copy {
    position: absolute;
    top: 255px;
    left: 10px;
    color: #fff;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgb(0 0 0 / 18%);
  }

  .industry-copy p {
    margin: 0 0 18px;
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: .08em;
  }

  .industry-copy .dark {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .industry-hero {
      height: 535px;
    }

    .industry-hero :global(img) {
      object-position: center;
    }

    .industry-copy {
      top: 215px;
      left: 20px;
    }

    .industry-copy p {
      margin-bottom: 12px;
      font-size: 1.75rem;
    }
  }
</style>
