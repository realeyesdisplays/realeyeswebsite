---
import { Image } from 'astro:assets';
import logo from '../assets/media/logo.png';
---

<footer class="site-shell footer-wrap">
  <div class="footer-content">
    <div class="footer-about">
      <div class="footer-brand">
        <Image src={logo} alt="" loading="lazy" />
        <strong>RealEyes Displays</strong>
      </div>
      <p>Got a question? Our passive and interactive digital signage experts are here to help. Whether you need to purchase a new display, bring existing black screens to life, or discuss a vendor partnership, let’s get connected.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <span>Quick Link</span>
      <a href="/">Home</a>
      <a href="/our-roots/">Our Roots</a>
      <a href="/passive-displays/">Passive Displays</a>
      <a href="/interactive/">Interactive</a>
      <a href="/partners/">Partners</a>
      <a href="/contact-us/">Contact</a>
      <a href="https://www.youtube.com/realeyesdisplays" target="_blank" rel="noopener" data-analytics="youtube_click">YouTube</a>
      <a href="https://realeyes.playr.biz/" target="_blank" rel="noopener" data-analytics="client_login">Client Login</a>
      <a href="https://realeyes.playr.biz/en/privacy_policy" target="_blank" rel="noopener" data-analytics="privacy_policy_click">Privacy Policy</a>
    </nav>
  </div>
  <div class="footer-wordmark" aria-hidden="true">RealEyes Displays</div>
</footer>

<style>
  .footer-wrap {
    position: relative;
    width: 90vw;
    max-width: none;
    height: 410px;
    margin-top: 36px;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
    background: var(--soft);
  }

  .footer-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 1fr);
    gap: 64px;
    width: min(100%, 1060px);
    margin-inline: auto;
    padding: 50px 40px;
  }

  .footer-about {
    justify-self: end;
    max-width: 440px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
  }

  .footer-brand img {
    width: 64px;
    height: 52px;
    object-fit: cover;
    object-position: top;
  }

  .footer-brand strong {
    font-size: 27px;
  }

  .footer-about p {
    font-size: 16px;
    line-height: 1.5;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    align-self: start;
  }

  .footer-nav span {
    grid-column: 1 / -1;
    margin-bottom: 2px;
    font-size: 18px;
  }

  .footer-nav a {
    display: grid;
    min-height: 42px;
    border: 1px solid rgb(38 38 38 / 14%);
    border-radius: 7px;
    padding: 8px 12px;
    background: rgb(255 255 255 / 70%);
    font-size: 16px;
    text-decoration: none;
    place-items: center;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    border-color: var(--red);
    color: #fff;
    background: var(--red);
    transform: translateY(-2px);
  }

  .footer-wordmark {
    position: absolute;
    right: 0;
    bottom: -.3em;
    left: 0;
    padding-inline: 18px;
    color: var(--red-bright);
    font-size: clamp(4rem, 9vw, 8rem);
    font-weight: 750;
    line-height: .9;
    opacity: 1;
    text-align: center;
    transform: none;
    transition: none;
    animation: none;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .footer-wrap {
      width: calc(100% - 20px);
      height: 620px;
      margin: 32px auto 0;
      border-radius: 22px 22px 0 0;
    }

    .footer-content {
      display: block;
      width: 100%;
      padding: 38px 20px;
    }

    .footer-about {
      justify-self: auto;
      max-width: none;
    }

    .footer-brand strong {
      font-size: 24px;
    }

    .footer-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 62px;
    }

    .footer-nav a {
      display: grid;
      width: 100%;
      min-height: 42px;
      border: 1px solid rgb(38 38 38 / 14%);
      border-radius: 7px;
      padding: 8px 12px;
      background: rgb(255 255 255 / 70%);
      place-items: center;
    }

    .footer-wordmark {
      bottom: -.25em;
      font-size: 2rem;
    }
  }
</style>
