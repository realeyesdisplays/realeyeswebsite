---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  poster: ImageMetadata;
  youtubeId: string;
}

const { title, poster, youtubeId } = Astro.props;
---

<article class="video-card" data-video-card>
  <h3>{title}</h3>
  <button type="button" class="video-poster" aria-label={`Play ${title}`} data-video-id={youtubeId}>
    <Image src={poster} alt="" loading="lazy" />
    <span aria-hidden="true">▶</span>
  </button>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-video-id]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.videoId;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = button.getAttribute('aria-label') ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      button.replaceWith(iframe);
    }, { once: true });
  });
</script>

<style>
  .video-card h3 {
    min-height: 48px;
    margin-bottom: 12px;
    font-size: 18px;
    text-align: center;
  }

  .video-poster,
  .video-card :global(iframe) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .video-poster {
    padding: 0;
    overflow: hidden;
    background: #111;
    cursor: pointer;
  }

  .video-poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-poster span {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    color: #fff;
    background: rgb(226 61 61 / 92%);
    place-items: center;
    transform: translate(-50%, -50%);
  }
</style>
