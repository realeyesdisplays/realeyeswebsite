---
import '@fontsource-variable/red-hat-display';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ModalHub from '../components/ModalHub.astro';
import defaultSocialImage from '../assets/media/banner1.jpg';
import logoMark from '../assets/media/REDLogoOfficial-Blk-Transp.png';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  structuredData?: boolean;
}

const {
  title,
  description,
  image = defaultSocialImage.src,
  imageAlt = 'RealEyes Displays digital signage installation',
  robots,
  structuredData = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isProduction = import.meta.env.PUBLIC_SITE_ENV === 'production';
const gaId = isProduction
  ? (import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || 'G-EBSGYCH5KC')
  : '';
const socialImage = new URL(image, Astro.site);
const logoUrl = new URL(logoMark.src, Astro.site);
const robotsContent = isProduction
  ? (robots ?? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1')
  : 'noindex, nofollow, noarchive';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://realeyesdisplays.com/#organization',
      name: 'RealEyes Displays',
      legalName: 'RealEyes Displays, LLC',
      url: 'https://realeyesdisplays.com/',
      logo: {
        '@type': 'ImageObject',
        url: logoUrl.href,
      },
      description: 'RealEyes Displays designs, deploys, and supports passive and interactive digital signage systems for organizations nationwide.',
      telephone: '+1-888-649-5289',
      areaServed: {
        '@type': 'Country',
        name: 'United States',
      },
      sameAs: ['https://www.youtube.com/realeyesdisplays'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://realeyesdisplays.com/#website',
      url: 'https://realeyesdisplays.com/',
      name: 'RealEyes Displays',
      publisher: { '@id': 'https://realeyesdisplays.com/#organization' },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { '@id': 'https://realeyesdisplays.com/#website' },
      about: { '@id': 'https://realeyesdisplays.com/#organization' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: socialImage.href,
      },
      inLanguage: 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#e23d3d" />
    <link rel="icon" type="image/png" href={logoMark.src} />
    <link rel="apple-touch-icon" href={logoMark.src} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="RealEyes Displays information for AI systems" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RealEyes Displays" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ModalHub />

    <script>
      const reveal = () => {
        const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          elements.forEach((element) => element.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        elements.forEach((element) => observer.observe(element));
      };

      reveal();
      document.addEventListener('astro:page-load', reveal);

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const target = event.target.closest<HTMLElement>('[data-form], [data-analytics]');
        if (!target) return;
        const analyticsWindow = window as Window & { gtag?: (...args: unknown[]) => void };
        const eventName = target.dataset.analytics ?? 'form_open';
        const eventLabel = target.dataset.form ?? target.textContent?.trim() ?? '';
        analyticsWindow.gtag?.('event', eventName, { event_label: eventLabel });
      });
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    z-index: 1000;
    top: 8px;
    left: 8px;
    padding: 10px 14px;
    color: #fff;
    background: var(--ink);
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
