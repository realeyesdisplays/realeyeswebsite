---
import '@fontsource-variable/red-hat-display';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ModalHub from '../components/ModalHub.astro';
import defaultSocialImage from '../assets/media/banner1.jpg';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = defaultSocialImage.src,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const gaId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e23d3d" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ModalHub />

    <script>
      const reveal = () => {
        const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          elements.forEach((element) => element.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        elements.forEach((element) => observer.observe(element));
      };

      reveal();
      document.addEventListener('astro:page-load', reveal);

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const target = event.target.closest<HTMLElement>('[data-form], [data-analytics]');
        if (!target) return;
        const analyticsWindow = window as Window & { gtag?: (...args: unknown[]) => void };
        const eventName = target.dataset.analytics ?? 'form_open';
        const eventLabel = target.dataset.form ?? target.textContent?.trim() ?? '';
        analyticsWindow.gtag?.('event', eventName, { event_label: eventLabel });
      });
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    z-index: 1000;
    top: 8px;
    left: 8px;
    padding: 10px 14px;
    color: #fff;
    background: var(--ink);
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
